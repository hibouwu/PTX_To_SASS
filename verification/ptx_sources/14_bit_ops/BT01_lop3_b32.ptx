.version 9.3
.target sm_100a
.address_size 64

// BT01: lop3.b32 (3-input logic)
.visible .entry test_lop3_b32() {
    .reg .b32 %r0, %r1, %r2, %r3;

    mov.b32 %r0, 0xFF00FF00;
mov.b32 %r1, 0xF0F0F0F0;
mov.b32 %r2, 0xCCCCCCCC;

    // === 待测指令 ===
    lop3.b32 %r3, %r0, %r1, %r2, 0xE8;

    ret;
}
