.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// BT01: lop3.b32 (3-input logic)
.visible .entry test_lop3_b32() {
    .reg .b32 %r0, %r1, %r2, %r3;

    mov.b32 %r0, 0xFF00FF00;
mov.b32 %r1, 0xF0F0F0F0;
mov.b32 %r2, 0xCCCCCCCC;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    lop3.b32 %r3, %r0, %r1, %r2, 0xE8;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r3;
    .loc 1 300 0

    ret;
}
