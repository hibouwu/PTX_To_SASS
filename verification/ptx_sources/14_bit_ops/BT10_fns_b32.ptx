.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// BT10: fns.b32 (find n-th set bit)
.visible .entry test_fns_b32() {
    .reg .b32 %r0, %r1;
    .reg .u32 %r2;

    mov.b32 %r0, 0xFF00FF00;
mov.b32 %r1, 3;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    fns.b32 %r2, %r0, 0, %r1;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r2;
    .loc 1 300 0

    ret;
}
