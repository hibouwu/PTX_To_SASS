.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// BT02: prmt.b32 (byte permute)
.visible .entry test_prmt_b32() {
    .reg .b32 %r0, %r1, %r2;

    mov.b32 %r0, 0xAABBCCDD;
mov.b32 %r1, 0x11223344;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    prmt.b32 %r2, %r0, %r1, 0x3210;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r2;
    .loc 1 300 0

    ret;
}
