.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// ACT02: tanh.approx.f16x2 (vectorized GELU)
.visible .entry test_tanh_f16x2() {
    .reg .b32 %v0, %v1;

    mov.b32 %v0, 0x3C003C00;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    tanh.approx.f16x2 %v1, %v0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %v1;
    .loc 1 300 0

    ret;
}
