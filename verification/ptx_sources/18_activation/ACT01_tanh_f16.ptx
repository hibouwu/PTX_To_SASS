.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// ACT01: tanh.approx.f16 (GELU approx)
.visible .entry test_tanh_f16() {
    .reg .f16 %h0, %h1;

    mov.b16 %h0, 0x3C00;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    tanh.approx.f16 %h1, %h0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b16 [__ptx_sink+0], %h1;
    .loc 1 300 0

    ret;
}
