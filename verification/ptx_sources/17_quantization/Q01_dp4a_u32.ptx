.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// Q01: dp4a.u32.u32 (INT8 dot product)
.visible .entry test_dp4a_u32() {
    .reg .u32 %r0, %r1, %r2;

    mov.u32 %r0, 0x01020304;
mov.u32 %r1, 0x01010101;
mov.u32 %r2, 0;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    dp4a.u32.u32 %r2, %r0, %r1, %r2;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r2;
    .loc 1 300 0

    ret;
}
