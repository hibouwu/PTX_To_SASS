.version 9.3
.target sm_100a
.address_size 64

// Q03: dp2a.lo.u32.u32 (INT16 dot product lo)
.visible .entry test_dp2a_lo() {
    .reg .u32 %r0, %r1, %r2;

    mov.u32 %r0, 0x00010002;
mov.u32 %r1, 0x00030004;
mov.u32 %r2, 0;

    // === 待测指令 ===
    dp2a.lo.u32.u32 %r2, %r0, %r1, %r2;

    ret;
}
