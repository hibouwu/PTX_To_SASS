.version 9.3
.target sm_100a
.address_size 64
.shared .align 8 .u64 smem_mbar;

.visible .entry test_mbarrier_arrive_expect_tx(
    .param .u32 p_tx
) {
    .reg .b64 %state;
    .reg .u32 %tx;
    ld.param.u32 %tx, [p_tx];

    // === 待测指令 ===
    mbarrier.arrive.expect_tx.shared::cta.b64 %state, [smem_mbar], %tx;

    ret;
}
