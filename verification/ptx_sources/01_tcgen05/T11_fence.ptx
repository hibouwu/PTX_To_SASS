.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

// T11: tcgen05.fence::after_thread_sync
.visible .entry test_tcgen05_fence() {
    .loc 1 10 0
    // === target instruction ===
