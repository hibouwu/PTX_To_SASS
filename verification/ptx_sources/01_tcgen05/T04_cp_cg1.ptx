.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

// T04: tcgen05.cp.cta_group::1.128x256b
.visible .entry test_tcgen05_cp(
    .param .u32 p_taddr,
    .param .u64 p_smem_desc
) {
    .reg .u32 %taddr;
    .reg .u64 %desc;

    ld.param.u32 %taddr, [p_taddr];
    ld.param.u64 %desc, [p_smem_desc];

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    tcgen05.cp.cta_group::1.128x256b [%taddr], %desc;
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0

    ret;
}
