.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// T05: tcgen05.ld.sync.aligned.16x64b.x1.b32
.visible .entry test_tcgen05_ld_16x64b_x1(
    .param .u32 p_taddr
) {
    .reg .u32 %taddr;
    .reg .b32 %dst<1>;

    ld.param.u32 %taddr, [p_taddr];

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    tcgen05.ld.sync.aligned.16x64b.x1.b32 {%dst0}, [%taddr];
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %dst0;
    .loc 1 300 0

    ret;
}
