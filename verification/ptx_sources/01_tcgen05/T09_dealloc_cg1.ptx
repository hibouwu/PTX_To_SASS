.version 9.3
.target sm_100a
.address_size 64

// T09: tcgen05.dealloc.cta_group::1.sync.aligned.b32
.visible .entry test_tcgen05_dealloc(
    .param .u32 p_taddr,
    .param .u32 p_ncols
) {
    .reg .u32 %taddr, %ncols;

    ld.param.u32 %taddr, [p_taddr];
    ld.param.u32 %ncols, [p_ncols];

    // === 待测指令 ===
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %taddr, %ncols;

    ret;
}
