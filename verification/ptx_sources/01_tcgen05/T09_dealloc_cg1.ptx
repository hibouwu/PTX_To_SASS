.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// T09: tcgen05.dealloc.cta_group::1.sync.aligned.b32
.visible .entry test_tcgen05_dealloc(
    .param .u32 p_taddr,
    .param .u32 p_ncols
) {
    .reg .u32 %taddr, %ncols;

    ld.param.u32 %taddr, [p_taddr];
    ld.param.u32 %ncols, [p_ncols];

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %taddr, %ncols;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %taddr;
    .loc 1 300 0

    ret;
}
