.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

// T07: tcgen05.st.sync.aligned
.visible .entry test_tcgen05_st(
    .param .u32 p_taddr
) {
    .reg .u32 %taddr;
    .reg .b32 %src<1>;

    ld.param.u32 %taddr, [p_taddr];
    mov.b32 %src0, 0;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    tcgen05.st.sync.aligned.16x64b.x1.b32 [%taddr], {%src0};
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0

    ret;
}
