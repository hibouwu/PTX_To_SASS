.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// BF08: fma.rn.bf16x2
.visible .entry test_fma_bf16x2() {
    .reg .b32 %v0, %v1, %v2;

    mov.b32 %v0, 0x3F803F80;
mov.b32 %v1, 0x40004000;
mov.b32 %v2, 0x00000000;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    fma.rn.bf16x2 %v2, %v0, %v1, %v2;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %v2;
    .loc 1 300 0

    ret;
}
