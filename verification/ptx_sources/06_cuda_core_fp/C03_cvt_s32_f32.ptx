.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// C03: cvt.rni.s32.f32 (float->int)
.visible .entry test_cvt_s32_f32() {
    .reg .f32 %f0;
    .reg .s32 %r0;

    mov.f32 %f0, 0f41280000;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    cvt.rni.s32.f32 %r0, %f0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r0;
    .loc 1 300 0

    ret;
}
