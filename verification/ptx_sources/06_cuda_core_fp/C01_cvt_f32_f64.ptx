.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// C01: cvt.rn.f32.f64 (f64->f32)
.visible .entry test_cvt_f32_f64() {
    .reg .f64 %fd0;
    .reg .f32 %f0;

    mov.f64 %fd0, 0d3FF0000000000000;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    cvt.rn.f32.f64 %f0, %fd0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %f0;
    .loc 1 300 0

    ret;
}
