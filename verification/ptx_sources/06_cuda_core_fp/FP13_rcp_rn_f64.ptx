.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// FP13: rcp.rn.f64 (HIGH RISK: Newton-Raphson?)
.visible .entry test_rcp_rn_f64() {
    .reg .f64 %fd0, %fd1;

    mov.f64 %fd0, 0d4000000000000000;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    rcp.rn.f64 %fd1, %fd0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b64 [__ptx_sink+0], %fd1;
    .loc 1 300 0

    ret;
}
