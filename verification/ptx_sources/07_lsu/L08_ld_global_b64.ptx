.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

.visible .entry test_ld_global_b64(
    .param .u64 p_addr
) {
    .reg .u64 %addr;
    .reg .b64 %rd0;

    ld.param.u64 %addr, [p_addr];

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    ld.global.b64 %rd0, [%addr];
    // === end target instruction ===
    .loc 1 200 0
    st.global.b64 [__ptx_sink+0], %rd0;
    .loc 1 300 0

    ret;
}
