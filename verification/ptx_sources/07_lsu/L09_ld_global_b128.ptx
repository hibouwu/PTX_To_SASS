.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

.visible .entry test_ld_global_b128(
    .param .u64 p_addr
) {
    .reg .u64 %addr;
    .reg .b32 %r0, %r1, %r2, %r3;

    ld.param.u64 %addr, [p_addr];

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    ld.global.v4.b32 {%r0, %r1, %r2, %r3}, [%addr];
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r0;
    st.global.b32 [__ptx_sink+4], %r1;
    st.global.b32 [__ptx_sink+8], %r2;
    st.global.b32 [__ptx_sink+12], %r3;
    .loc 1 300 0

    ret;
}
