.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

.shared .align 4 .u32 smem_data[256];

.visible .entry test_st_shared_b32() {
    .reg .u32 %r0;
    mov.u32 %r0, 42;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    st.shared.b32 [smem_data], %r0;
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0

    ret;
}
