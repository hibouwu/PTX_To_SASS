.version 9.3
.target sm_100a
.address_size 64

.shared .align 16 .u32 smem_data128[256];

.visible .entry test_st_shared_b128() {
    .reg .b32 %r0, %r1, %r2, %r3;
    mov.b32 %r0, 1;
    mov.b32 %r1, 2;
    mov.b32 %r2, 3;
    mov.b32 %r3, 4;

    // === 待测指令 ===
    st.shared.v4.b32 [smem_data128], {%r0, %r1, %r2, %r3};

    ret;
}
