.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

.visible .entry test_st_global_b64(
    .param .u64 p_addr
) {
    .reg .u64 %addr;
    .reg .b64 %rd0;

    ld.param.u64 %addr, [p_addr];
    mov.b64 %rd0, 42;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    st.global.b64 [%addr], %rd0;
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0

    ret;
}
