.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// W14: elect.sync (leader election)
.visible .entry test_elect_sync() {
    .reg .b32 %r0;
    .reg .pred %p0;

    // no setup

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    elect.sync %r0|%p0, 0xFFFFFFFF;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r0;
    @%p0 st.global.u32 [__ptx_sink+4], 1;
    @!%p0 st.global.u32 [__ptx_sink+4], 0;
    .loc 1 300 0

    ret;
}
