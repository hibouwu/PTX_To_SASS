.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// W13: match.sync.any.b32
.visible .entry test_match_any() {
    .reg .b32 %r0, %r1;

    mov.b32 %r0, %tid.x;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    match.sync.any.b32 %r1, %r0, 0xFFFFFFFF;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r1;
    .loc 1 300 0

    ret;
}
