.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// H11: neg.f16x2
.visible .entry test_neg_f16x2() {
    .reg .b32 %v0, %v1;

    mov.u32 %v0, %clock;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    neg.f16x2 %v1, %v0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %v1;
    .loc 1 300 0

    ret;
}
