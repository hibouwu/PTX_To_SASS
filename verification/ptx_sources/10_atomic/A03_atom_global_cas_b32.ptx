.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

.visible .entry test_atom_global_cas_b32(
    .param .u64 p_addr
) {
    .reg .u64 %addr;
    .reg .b32 %cmp, %new_val, %old;

    ld.param.u64 %addr, [p_addr];
    mov.b32 %cmp, 0;
    mov.b32 %new_val, 1;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    atom.global.cas.b32 %old, [%addr], %cmp, %new_val;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %old;
    .loc 1 300 0

    ret;
}
