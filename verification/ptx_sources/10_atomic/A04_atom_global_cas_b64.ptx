.version 9.3
.target sm_100a
.address_size 64

.visible .entry test_atom_global_cas_b64(
    .param .u64 p_addr
) {
    .reg .u64 %addr;
    .reg .b64 %cmp, %new_val, %old;

    ld.param.u64 %addr, [p_addr];
    mov.b64 %cmp, 0;
    mov.b64 %new_val, 1;

    // === 待测指令 ===
    atom.global.cas.b64 %old, [%addr], %cmp, %new_val;

    ret;
}
