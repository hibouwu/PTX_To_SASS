.version 9.3
.target sm_100a
.address_size 64

// CL05: ld.shared::cluster.b32
.shared .align 4 .u32 smem_data[256];

.visible .entry test_ld_shared_cluster() {
    .reg .u32 %r0, %rank;
    .reg .u64 %remote_addr;

    mov.u32 %rank, 0;
    mapa.shared::cluster.u32 %remote_addr, smem_data, %rank;

    // === 待测指令 ===
    ld.shared::cluster.b32 %r0, [%remote_addr];

    ret;
}
