.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// CL01: mapa.shared::cluster
.shared .align 4 .u32 smem_data[256];

.visible .entry test_mapa() {
    .reg .u32 %r0, %rank;
    .reg .u32 %addr;

    mov.u32 %rank, 0;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    mapa.shared::cluster.u32 %addr, smem_data, %rank;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %addr;
    .loc 1 300 0

    ret;
}
