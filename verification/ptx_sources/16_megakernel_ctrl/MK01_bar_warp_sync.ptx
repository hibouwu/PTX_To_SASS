.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

// MK01: bar.warp.sync
.visible .entry test_bar_warp_sync() {
    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    bar.warp.sync 0xFFFFFFFF;
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0

    ret;
}
