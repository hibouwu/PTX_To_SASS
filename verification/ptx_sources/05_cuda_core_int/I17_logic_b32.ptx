.version 9.3
.target sm_100a
.address_size 64

// I17: and/or/xor.b32
.visible .entry test_logic_b32() {
    .reg .b32 %r0, %r1, %r2;

    mov.b32 %r0, 0xFF00FF00;
mov.b32 %r1, 0x0F0F0F0F;

    // === 待测指令 ===
    and.b32 %r2, %r0, %r1;
    or.b32 %r2, %r2, %r0;
    xor.b32 %r2, %r2, %r1;

    ret;
}
