.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// I21B: mov.b64 (data movement)
.visible .entry test_mov_b64() {
    .reg .b64 %rd0, %rd1;

    mov.b64 %rd0, 42;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    mov.b64 %rd1, %rd0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b64 [__ptx_sink+0], %rd1;
    .loc 1 300 0

    ret;
}
