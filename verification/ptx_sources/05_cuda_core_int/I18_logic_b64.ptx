.version 9.3
.target sm_100a
.address_size 64

// I18: and.b64 / or.b64
.visible .entry test_logic_b64() {
    .reg .b64 %rd0, %rd1, %rd2;

    mov.b64 %rd0, 0xFF00FF00FF00FF00;
mov.b64 %rd1, 0x0F0F0F0F0F0F0F0F;

    // === 待测指令 ===
    and.b64 %rd2, %rd0, %rd1;
    or.b64 %rd2, %rd0, %rd1;

    ret;
}
