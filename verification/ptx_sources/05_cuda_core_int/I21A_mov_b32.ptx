.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// I21A: mov.b32 (data movement)
.visible .entry test_mov_b32() {
    .reg .b32 %r0, %r1;

    mov.b32 %r0, 42;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    mov.b32 %r1, %r0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r1;
    .loc 1 300 0

    ret;
}
