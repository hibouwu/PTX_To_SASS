.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

.visible .entry test_barrier_cluster_wait() {
    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    barrier.cluster.wait;
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0
    ret;
}
