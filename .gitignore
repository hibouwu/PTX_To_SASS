# Python cache
__pycache__/
*.py[cod]

# Generated CUDA artifacts
verification/cubins/
verification/sass_dumps/

# Generated composed-semantic-suite run logs and artifacts.  Each family may
# also keep a narrow .gitignore beside its source; these top-level rules make
# the dispatcher output safe regardless of which family produced it.
verification/semantic_suite/artifacts/
verification/semantic_suite/**/artifacts/
verification/semantic_suite/**/build/
verification/semantic_suite/**/cubin/
verification/semantic_suite/**/sass/
verification/semantic_suite/**/runtime_results*.txt

# Local editor and OS files
.DS_Store
*~
*.swp
