.version 8.0
.target sm_80
.address_size 64

// TEST: dead-code elimination
// QUESTION: Is the unused multiply retained at each optimization level?
.visible .entry case_dead_code(
    .param .u64 in_ptr,
    .param .u64 out_ptr
) {
    .reg .u64 %in, %out;
    .reg .u32 %x, %dead, %live;

    ld.param.u64 %in, [in_ptr];
    ld.param.u64 %out, [out_ptr];
    ld.global.u32 %x, [%in];
    mul.lo.u32 %dead, %x, 17;
    add.u32 %live, %x, 1;
    st.global.u32 [%out], %live;
    ret;
}
