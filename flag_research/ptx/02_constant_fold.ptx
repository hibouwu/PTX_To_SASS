.version 8.0
.target sm_80
.address_size 64

// TEST: constant folding and propagation
// QUESTION: When does the mov/add/mul constant chain become one constant?
.visible .entry case_constant_fold(
    .param .u64 out_ptr
) {
    .reg .u64 %out;
    .reg .u32 %a, %b, %c, %d;

    ld.param.u64 %out, [out_ptr];
    mov.u32 %a, 7;
    mov.u32 %b, 9;
    add.u32 %c, %a, %b;
    mul.lo.u32 %d, %c, 5;
    st.global.u32 [%out], %d;
    ret;
}
