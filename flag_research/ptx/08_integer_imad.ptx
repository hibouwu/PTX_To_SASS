.version 8.0
.target sm_80
.address_size 64

// TEST: integer multiply/add selection
// FUSION: mul.lo.u32 + add.u32 may select one IMAD SASS instruction.
.visible .entry case_integer_imad(
    .param .u64 in_ptr,
    .param .u64 out_ptr
) {
    .reg .u64 %in, %out;
    .reg .u32 %a, %b, %c, %product, %result;

    ld.param.u64 %in, [in_ptr];
    ld.param.u64 %out, [out_ptr];
    ld.global.u32 %a, [%in];
    ld.global.u32 %b, [%in+4];
    ld.global.u32 %c, [%in+8];
    mul.lo.u32 %product, %a, %b;
    add.u32 %result, %product, %c;
    st.global.u32 [%out], %result;
    ret;
}
