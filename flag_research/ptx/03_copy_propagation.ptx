.version 8.0
.target sm_80
.address_size 64

// TEST: copy propagation
// QUESTION: When are redundant register-to-register moves removed?
.visible .entry case_copy_propagation(
    .param .u64 in_ptr,
    .param .u64 out_ptr
) {
    .reg .u64 %in, %out;
    .reg .u32 %a, %b, %c, %d;

    ld.param.u64 %in, [in_ptr];
    ld.param.u64 %out, [out_ptr];
    ld.global.u32 %a, [%in];
    mov.u32 %b, %a;
    mov.u32 %c, %b;
    add.u32 %d, %c, 3;
    st.global.u32 [%out], %d;
    ret;
}
