.version 8.0
.target sm_80
.address_size 64

// TEST: floating-point multiply/add contraction
// FUSION: mul.f32 + add.f32 -> FFMA (when contraction is permitted)
// NOTE: Omitting explicit rounding modifiers is intentional. PTXAS treats an
//       explicit rounding modifier as a request to preserve the operation.
// CONTROL: run.sh also compiles this case with -fmad=false.
.visible .entry case_fma_contract(
    .param .u64 in_ptr,
    .param .u64 out_ptr
) {
    .reg .u64 %in, %out;
    .reg .f32 %a, %b, %c, %product, %result;

    ld.param.u64 %in, [in_ptr];
    ld.param.u64 %out, [out_ptr];
    ld.global.f32 %a, [%in];
    ld.global.f32 %b, [%in+4];
    ld.global.f32 %c, [%in+8];
    mul.f32 %product, %a, %b;
    add.f32 %result, %product, %c;
    st.global.f32 [%out], %result;
    ret;
}
