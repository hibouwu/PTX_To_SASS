.version 8.0
.target sm_80
.address_size 64

// TEST: constant address-offset folding
// FUSION: add.u64 base, 16 followed by ld.global may fold the immediate into
//         the memory operand instead of emitting a standalone integer add.
.visible .entry case_load_address_fold(
    .param .u64 in_ptr,
    .param .u64 out_ptr
) {
    .reg .u64 %in, %out, %address;
    .reg .u32 %value;

    ld.param.u64 %in, [in_ptr];
    ld.param.u64 %out, [out_ptr];
    add.u64 %address, %in, 16;
    ld.global.u32 %value, [%address];
    st.global.u32 [%out], %value;
    ret;
}
