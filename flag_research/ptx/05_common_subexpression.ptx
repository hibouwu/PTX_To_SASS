.version 8.0
.target sm_80
.address_size 64

// TEST: common-subexpression elimination
// QUESTION: Are two identical dynamic multiplies computed once?
.visible .entry case_common_subexpression(
    .param .u64 in_ptr,
    .param .u64 out_ptr
) {
    .reg .u64 %in, %out;
    .reg .u32 %x, %a, %b, %sum;

    ld.param.u64 %in, [in_ptr];
    ld.param.u64 %out, [out_ptr];
    ld.global.u32 %x, [%in];
    mul.lo.u32 %a, %x, 13;
    mul.lo.u32 %b, %x, 13;
    add.u32 %sum, %a, %b;
    st.global.u32 [%out], %sum;
    ret;
}
