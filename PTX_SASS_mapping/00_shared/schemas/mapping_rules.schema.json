{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ptx-sass/schemas/mapping_rules.schema.json",
  "title": "PTX to SASS mapping rule set",
  "type": "object",
  "required": ["schema_version", "environment", "rules"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "environment": {"type": "object"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "direction", "level", "when", "then", "evidence"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "direction": {"enum": ["PTX_TO_SASS", "SASS_TO_PTX", "BIDIRECTIONAL"]},
          "level": {"enum": ["core_opcode", "operand", "encoding", "context_lowering", "runtime_semantics", "legality"]},
          "when": {"type": "object"},
          "then": {"type": "object"},
          "evidence_grade": {"enum": ["DETERMINISTIC", "CONDITIONAL", "OBSERVATION", "UNVERIFIED"]},
          "evidence": {
            "type": "object",
            "required": ["support_count", "counterexample_count"],
            "properties": {
              "support_count": {"type": "integer", "minimum": 0},
              "counterexample_count": {"type": "integer", "minimum": 0},
              "case_labels": {"type": "array", "items": {"type": "string"}},
              "artifact_links": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          },
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
