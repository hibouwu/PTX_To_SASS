{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ptx-sass/schemas/factors.schema.json",
  "title": "PTX to SASS factor model",
  "type": "object",
  "required": ["schema_version", "family_id", "opcode", "factors", "coverage"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "opcode": {"type": "string", "minLength": 1},
    "environment_id": {"type": ["string", "null"]},
    "factors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "levels"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "class": {"enum": ["SF", "CTX", "RUN", "ENV", "OBS"]},
          "levels": {"type": "array", "minItems": 1, "items": {}},
          "description": {"type": "string"},
          "applicability": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "constraints": {"type": "array", "items": {"type": "object"}},
    "coverage": {
      "type": "object",
      "required": ["strategy", "stopping_condition"],
      "properties": {
        "strategy": {"enum": ["constrained_exhaustive", "pairwise", "t_wise", "targeted", "mixed"]},
        "strength": {"type": ["integer", "null"], "minimum": 1},
        "high_risk_interactions": {"type": "array", "items": {"type": "array", "minItems": 2, "items": {"type": "string"}}},
        "stopping_condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
