{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ptx-sass/schemas/manifest.schema.json",
  "title": "PTX to SASS testcase manifest record",
  "type": "object",
  "required": ["case_label", "kernel", "semantic_form", "semantic_form_id", "target_instructions", "target_occurrence_count", "validation_scope"],
  "properties": {
    "case_label": {"type": "string", "minLength": 1},
    "kernel": {"type": "string", "minLength": 1},
    "semantic_form": {"type": "object"},
    "semantic_form_id": {"type": "string", "minLength": 1},
    "source_variant": {"type": "object"},
    "source_variant_id": {"type": "string"},
    "source_implementation_id": {"type": "string"},
    "static_context_assignment": {"type": "object"},
    "static_context_id": {"type": "string"},
    "target_instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "target_occurrence_count": {"type": "integer", "minimum": 1},
    "validation_scope": {"enum": ["STATIC_ASSEMBLY_ONLY", "STATIC_ATTRIBUTION", "RUNTIME_SEMANTIC", "RUNTIME_PROTOCOL"]},
    "source_shard": {"type": "string"},
    "environment_id": {"type": "string"}
  },
  "additionalProperties": true
}
