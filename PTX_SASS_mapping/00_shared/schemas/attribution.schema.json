{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ptx-sass/schemas/attribution.schema.json",
  "title": "PTX occurrence to SASS attribution record",
  "type": "object",
  "required": ["case_label", "occurrence_index", "status", "observation_level"],
  "properties": {
    "case_label": {"type": "string", "minLength": 1},
    "occurrence_index": {"type": "integer", "minimum": 0},
    "ptx_instruction": {"type": "string"},
    "status": {"enum": ["ATTRIBUTED", "TARGET_ELIMINATED", "ATTRIBUTION_UNKNOWN", "OBSERVED_VARIANT", "COMPILE_REJECTED"]},
    "observation_level": {"enum": ["exact", "allocation", "semantic"]},
    "sass_instructions": {"type": "array", "items": {"type": "string"}},
    "encoding_words": {"type": "array", "items": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"}},
    "effect_slice": {"type": "object"},
    "environment_id": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
