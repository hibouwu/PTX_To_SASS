.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// H03: mul.f16
.visible .entry test_mul_f16() {
    .reg .f16 %h0, %h1, %h2;

    mov.b16 %h0, 0x3C00;
mov.b16 %h1, 0x4000;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    mul.f16 %h2, %h0, %h1;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b16 [__ptx_sink+0], %h2;
    .loc 1 300 0

    ret;
}
