.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// H15: setp.gt.f16
.visible .entry test_setp_f16() {
    .reg .f16 %h0, %h1;
    .reg .pred %p0;

    mov.b16 %h0, 0x4000;
mov.b16 %h1, 0x3C00;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    setp.gt.f16 %p0, %h0, %h1;
    // === end target instruction ===
    .loc 1 200 0
    @%p0 st.global.u32 [__ptx_sink+0], 1;
    @!%p0 st.global.u32 [__ptx_sink+0], 0;
    .loc 1 300 0

    ret;
}
