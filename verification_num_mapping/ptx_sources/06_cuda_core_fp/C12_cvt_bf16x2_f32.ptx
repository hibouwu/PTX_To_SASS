.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// C12: cvt.rn.bf16x2.f32 (packed F32->BF16x2, HIGH RISK)
.visible .entry test_cvt_bf16x2_f32() {
    .reg .f32 %f0, %f1;
    .reg .b32 %v0;

    mov.f32 %f0, 0f3F800000;
mov.f32 %f1, 0f40000000;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    cvt.rn.bf16x2.f32 %v0, %f0, %f1;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %v0;
    .loc 1 300 0

    ret;
}
