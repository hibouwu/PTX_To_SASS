.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// C06: cvt.u32.u64 (truncate)
.visible .entry test_cvt_u32_u64() {
    .reg .u64 %rd0;
    .reg .u32 %r0;

    mov.u64 %rd0, 0x00000000DEADBEEF;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    cvt.u32.u64 %r0, %rd0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r0;
    .loc 1 300 0

    ret;
}
