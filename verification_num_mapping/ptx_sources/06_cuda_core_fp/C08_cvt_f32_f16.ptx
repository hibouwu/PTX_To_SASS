.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// C08: cvt.f32.f16 (f16->f32)
.visible .entry test_cvt_f32_f16() {
    .reg .f16 %h0;
    .reg .f32 %f0;

    mov.b16 %h0, 0x3C00;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    cvt.f32.f16 %f0, %h0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %f0;
    .loc 1 300 0

    ret;
}
