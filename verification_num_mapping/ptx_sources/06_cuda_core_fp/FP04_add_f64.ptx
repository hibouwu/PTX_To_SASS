.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// FP04: add.f64
.visible .entry test_add_f64() {
    .reg .f64 %fd0, %fd1, %fd2;

    mov.f64 %fd0, 0d3FF0000000000000;
mov.f64 %fd1, 0d4000000000000000;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    add.f64 %fd2, %fd0, %fd1;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b64 [__ptx_sink+0], %fd2;
    .loc 1 300 0

    ret;
}
