.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// FP15: add.f16x2 (FP16 vector)
.visible .entry test_add_f16x2() {
    .reg .b32 %h0, %h1, %h2;

    mov.b32 %h0, 0x3C003C00;
mov.b32 %h1, 0x4000C000;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    add.f16x2 %h2, %h0, %h1;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %h2;
    .loc 1 300 0

    ret;
}
