.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// ACT03: tanh.approx.bf16
.visible .entry test_tanh_bf16() {
    .reg .b16 %b0, %b1;

    mov.b16 %b0, 0x3F80;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    tanh.approx.bf16 %b1, %b0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b16 [__ptx_sink+0], %b1;
    .loc 1 300 0

    ret;
}
