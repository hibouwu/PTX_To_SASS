.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// Q04: dp2a.hi.u32.u32 (INT16 dot product hi)
.visible .entry test_dp2a_hi() {
    .reg .u32 %r0, %r1, %r2;

    mov.u32 %r0, 0x00010002;
mov.u32 %r1, 0x00030004;
mov.u32 %r2, 0;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    dp2a.hi.u32.u32 %r2, %r0, %r1, %r2;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r2;
    .loc 1 300 0

    ret;
}
