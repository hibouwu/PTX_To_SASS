.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

.shared .align 4 .u32 smem_atomic;

.visible .entry test_atom_shared_add_u32() {
    .reg .u32 %r0, %old;
    mov.u32 %r0, 1;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    atom.shared.add.u32 %old, [smem_atomic], %r0;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %old;
    .loc 1 300 0

    ret;
}
