.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

.shared .align 16 .u64 smem_data64[128];

.visible .entry test_st_shared_v2b64() {
    .reg .b64 %rd0, %rd1;
    mov.b64 %rd0, 1;
    mov.b64 %rd1, 2;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    st.shared.v2.b64 [smem_data64], {%rd0, %rd1};
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0

    ret;
}
