.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// W07: redux.sync.add.f32 (negative test)
// EXPECTED_UNSUPPORTED_BY_PTX_ISA: PTX ISA 9.3 permits .add only with .u32/.s32; .f32 permits only .min/.max
.visible .entry test_redux_add_f32() {
    .reg .f32 %f0, %f1;

    mov.f32 %f0, 0f3F800000;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    redux.sync.add.f32 %f1, %f0, 0xFFFFFFFF;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %f1;
    .loc 1 300 0

    ret;
}
