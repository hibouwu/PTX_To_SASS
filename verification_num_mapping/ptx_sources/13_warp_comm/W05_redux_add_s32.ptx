.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// W05: redux.sync.add.s32
.visible .entry test_redux_add_s32() {
    .reg .s32 %r0, %r1;

    mov.s32 %r0, 1;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    redux.sync.add.s32 %r1, %r0, 0xFFFFFFFF;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r1;
    .loc 1 300 0

    ret;
}
