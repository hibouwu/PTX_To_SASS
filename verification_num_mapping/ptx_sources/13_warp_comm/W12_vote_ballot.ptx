.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// W12: vote.sync.ballot.b32
.visible .entry test_vote_ballot() {
    .reg .pred %p0;
    .reg .b32 %r0;
    .reg .u32 %lane;

    mov.u32 %lane, %tid.x;
setp.gt.u32 %p0, %lane, 15;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    vote.sync.ballot.b32 %r0, %p0, 0xFFFFFFFF;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r0;
    .loc 1 300 0

    ret;
}
