.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

// M10: cp.async.wait_group 0
.visible .entry test_cp_async_wait() {
    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    cp.async.wait_group 0;
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0

    ret;
}
