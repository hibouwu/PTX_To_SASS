.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

// M08: cp.async.ca.shared.global (pre-TMA async copy)
.shared .align 4 .u32 smem_data[256];

.visible .entry test_cp_async_ca(
    .param .u64 p_gaddr
) {
    .reg .u64 %gaddr;
    ld.param.u64 %gaddr, [p_gaddr];

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    cp.async.ca.shared.global [smem_data], [%gaddr], 4;
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0

    ret;
}
