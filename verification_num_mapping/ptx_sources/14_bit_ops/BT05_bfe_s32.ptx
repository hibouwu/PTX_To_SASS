.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// BT05: bfe.s32 (signed bit field extract)
.visible .entry test_bfe_s32() {
    .reg .s32 %r0, %r1;

    mov.s32 %r0, 0xDEADBEEF;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    bfe.s32 %r1, %r0, 8, 4;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b32 [__ptx_sink+0], %r1;
    .loc 1 300 0

    ret;
}
