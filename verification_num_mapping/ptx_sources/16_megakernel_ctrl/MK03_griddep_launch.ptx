.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"

// MK03: griddepcontrol.launch_dependents
.visible .entry test_griddep_launch() {
    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    griddepcontrol.launch_dependents;
    // === end target instruction ===
    .loc 1 200 0
    .loc 1 300 0

    ret;
}
