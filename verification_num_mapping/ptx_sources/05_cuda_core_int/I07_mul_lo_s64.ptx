.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// I07: mul.lo.s64
.visible .entry test_mul_lo_s64() {
    .reg .s64 %rd0, %rd1, %rd2;

    mov.s64 %rd0, 42;
mov.s64 %rd1, 7;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    mul.lo.s64 %rd2, %rd0, %rd1;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b64 [__ptx_sink+0], %rd2;
    .loc 1 300 0

    ret;
}
