.version 8.7
.target sm_100a
.address_size 64
.file 1 "ptx_mapping_case.ptx"
.global .align 16 .b8 __ptx_sink[256];

// I18A: and.b64 %rd2, %rd0, %rd1
.visible .entry test_and_b64() {
    .reg .b64 %rd0, %rd1, %rd2;

    mov.b64 %rd0, 0xFF00FF00FF00FF00;
mov.b64 %rd1, 0x0F0F0F0F0F0F0F0F;

    .loc 1 10 0
    // === target instruction ===
    .loc 1 100 0
    and.b64 %rd2, %rd0, %rd1;
    // === end target instruction ===
    .loc 1 200 0
    st.global.b64 [__ptx_sink+0], %rd2;
    .loc 1 300 0

    ret;
}
