.version 8.7
.target sm_100a
.address_size 64
.file 1 "tma_swizzle_roundtrip_2d.ptx"

// The runner supplies matching swizzled input and output maps for 32B, 64B,
// and 128B spans.  TMA load writes the physical swizzled shared layout and
// the subsequent TMA store decodes that same layout back to row-major global.
.shared .align 128 .b8 smem_tile[1024];
.shared .align 8 .b64 smem_bar;

.visible .entry semantic_tma_swizzle_roundtrip_2d(
    .param .u64 p_input_desc,
    .param .u64 p_output_desc,
    .param .u32 p_bytes,
    .param .u64 p_status
) {
    .reg .pred %p<3>;
    .reg .u32 %r<9>;
    .reg .u64 %rd<5>;

    mov.u32 %r0, %tid.x;
    setp.eq.u32 %p0, %r0, 0;
    @%p0 mbarrier.init.shared::cta.b64 [smem_bar], 1;
    bar.sync 0;
    @!%p0 bra TMA_SWIZZLE_DONE;

    ld.param.u64 %rd0, [p_input_desc];
    ld.param.u64 %rd1, [p_output_desc];
    ld.param.u32 %r1, [p_bytes];
    ld.param.u64 %rd2, [p_status];
    fence.proxy.tensormap::generic.acquire.sys [%rd0], 128;
    fence.proxy.tensormap::generic.acquire.sys [%rd1], 128;
    fence.proxy.async.shared::cta;
    mov.u32 %r2, 0;
    cp.async.bulk.tensor.2d.shared::cta.global.mbarrier::complete_tx::bytes
        [smem_tile], [%rd0, {%r2, %r2}], [smem_bar];
    mbarrier.arrive.expect_tx.release.cta.shared::cta.b64 %rd3, [smem_bar], %r1;

TMA_SWIZZLE_WAIT:
    mbarrier.try_wait.acquire.cta.shared::cta.b64 %p1, [smem_bar], %rd3;
    @!%p1 bra TMA_SWIZZLE_WAIT;

    // The async proxy consumes the same swizzled shared layout that it wrote.
    fence.proxy.async.shared::cta;
    cp.async.bulk.tensor.2d.global.shared::cta.tile.bulk_group
        [%rd1, {%r2, %r2}], [smem_tile];
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;

    mov.u32 %r8, 0x5A122001;
    st.global.u32 [%rd2], %r8;
    mbarrier.inval.shared::cta.b64 [smem_bar];

TMA_SWIZZLE_DONE:
    ret;
}
