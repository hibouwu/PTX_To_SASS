// SPDX-License-Identifier: MIT
//
// Semantic (not 1:1 mapping) tests for CTA-scope mbarrier.
//
// These kernels deliberately keep the whole protocol in one kernel:
//   initialize -> publish initialization -> arrive/expect transaction
//   -> wait for the completed phase -> observe a result -> invalidate.
//
// Launch contract for all five entries: exactly one CTA of 32 x 1 x 1 threads.
// The host runner in this directory enforces that contract.

.version 8.7
.target sm_100a
.address_size 64

.file 1 "mbarrier_semantic.ptx"

.shared .align 8 .u64 smem_bar;
.shared .align 8 .u64 smem_control_bar;
.shared .align 4 .u32 smem_values[32];

// ---------------------------------------------------------------------------
// Test 1: ordinary mbarrier arrival and wait.
//
// Every lane publishes `tid.x + 1` with a release arrive.  After a separate
// control barrier confirms all arrivals, lane 0 observes phase completion
// with an acquire try_wait and sums all 32 values.  The required output is
// 1 + ... + 32 = 528.
// ---------------------------------------------------------------------------
.visible .entry test_mbarrier_arrive_wait(
    .param .u64 p_out
) {
    .reg .pred %p_tid0, %p_done, %p_control_done, %p_sum_end;
    .reg .u32 %r_tid, %r_count, %r_offset, %r_value, %r_index, %r_sum;
    .reg .u32 %r_smem_base, %r_smem_addr;
    .reg .b64 %rd_out, %rd_state, %rd_control_state;

    ld.param.u64 %rd_out, [p_out];
    mov.u32 %r_tid, %tid.x;
    setp.eq.u32 %p_tid0, %r_tid, 0;

    // A single thread initializes the barrier for all 32 CTA participants.
    @!%p_tid0 bra AW_INIT_DONE;
    mov.u32 %r_count, 32;
    mbarrier.init.shared::cta.b64 [smem_bar], %r_count;
    mbarrier.init.shared::cta.b64 [smem_control_bar], %r_count;
AW_INIT_DONE:
    // Publish the initialized shared barrier before any arrival.
    bar.sync 0;

    // ptxas accepts a shared symbol materialized into a 32-bit shared
    // address.  It avoids the invalid symbol+register addressing form.
    mov.u32 %r_smem_base, smem_values;
    shl.b32 %r_offset, %r_tid, 2;
    add.u32 %r_value, %r_tid, 1;
    add.u32 %r_smem_addr, %r_smem_base, %r_offset;
    st.shared.u32 [%r_smem_addr], %r_value;

    // The returned phase token is the state this lane waits to see complete.
    mbarrier.arrive.release.cta.shared::cta.b64 %rd_state, [smem_bar];

    // A second mbarrier (without acquire semantics) tells lane 0 that every
    // participant has executed the main arrive.  It is not a shared-memory
    // visibility mechanism; only the main barrier's acquire wait is used
    // before consuming smem_values.
    // Explicitly relaxed: this barrier is only a progress check.  It must not
    // add a second release->acquire visibility edge for smem_values.
    mbarrier.arrive.relaxed.cta.shared::cta.b64 %rd_control_state, [smem_control_bar];
    @!%p_tid0 bra AW_EXIT;

AW_CONTROL_WAIT_LOOP:
    mbarrier.try_wait.relaxed.cta.shared::cta.b64 %p_control_done, [smem_control_bar], %rd_control_state;
    @!%p_control_done bra AW_CONTROL_WAIT_LOOP;

AW_WAIT_LOOP:
    mbarrier.try_wait.acquire.cta.shared::cta.b64 %p_done, [smem_bar], %rd_state;
    @!%p_done bra AW_WAIT_LOOP;

    // The acquire wait makes all release-published shared values observable.
    mov.u32 %r_index, 0;
    mov.u32 %r_sum, 0;
AW_SUM_LOOP:
    setp.ge.u32 %p_sum_end, %r_index, 32;
    @%p_sum_end bra AW_SUM_FINISH;
    shl.b32 %r_offset, %r_index, 2;
    add.u32 %r_smem_addr, %r_smem_base, %r_offset;
    ld.shared.u32 %r_value, [%r_smem_addr];
    add.u32 %r_sum, %r_sum, %r_value;
    add.u32 %r_index, %r_index, 1;
    bra AW_SUM_LOOP;
AW_SUM_FINISH:
    st.global.u32 [%rd_out], %r_sum;
AW_SUM_DONE:
    // Control-barrier completion proves workers have no later barrier use.
    mbarrier.inval.shared::cta.b64 [smem_bar];
    mbarrier.inval.shared::cta.b64 [smem_control_bar];
AW_EXIT:
    ret;
}

// ---------------------------------------------------------------------------
// Test 2: explicit expect_tx / complete_tx, without TMA or MMA.
//
// Lane 0 first adds one transaction to the barrier.  All 32 lanes then
// arrive, making the arrival count zero but leaving transaction count = 1.
// The test_wait must still be false.  Lane 0 explicitly complete_tx(1), after
// which lane 0's try_wait succeeds.  The two output words are:
//   out[0] = 1          : the early wait correctly observed "not complete"
//   out[1] = 0xC0DEC0DE : wait succeeded after complete_tx
// ---------------------------------------------------------------------------
.visible .entry test_mbarrier_expect_tx_complete_tx(
    .param .u64 p_out
) {
    .reg .pred %p_tid0, %p_done, %p_control_done, %p_early_done;
    .reg .u32 %r_tid, %r_count, %r_tx, %r_early_status, %r_magic;
    .reg .b64 %rd_out, %rd_out1, %rd_state, %rd_control_state;

    ld.param.u64 %rd_out, [p_out];
    add.u64 %rd_out1, %rd_out, 4;
    mov.u32 %r_tid, %tid.x;
    setp.eq.u32 %p_tid0, %r_tid, 0;

    @!%p_tid0 bra ETC_INIT_DONE;
    mov.u32 %r_count, 32;
    mbarrier.init.shared::cta.b64 [smem_bar], %r_count;
    mbarrier.init.shared::cta.b64 [smem_control_bar], %r_count;
ETC_INIT_DONE:
    bar.sync 0;

    // This must happen before *any* arrival, hence the second CTA barrier.
    @!%p_tid0 bra ETC_EXPECT_DONE;
    mov.u32 %r_tx, 1;
    mbarrier.expect_tx.relaxed.cta.shared::cta.b64 [smem_bar], %r_tx;
ETC_EXPECT_DONE:
    bar.sync 0;

    // All 32 arrivals complete the arrival half of the phase.
    mbarrier.arrive.release.cta.shared::cta.b64 %rd_state, [smem_bar];
    // Do not use bar.sync after data/arrival: a separate non-acquire
    // mbarrier establishes only that all main arrivals have executed.
    mbarrier.arrive.relaxed.cta.shared::cta.b64 %rd_control_state, [smem_control_bar];
    @!%p_tid0 bra ETC_EXIT;

ETC_CONTROL_WAIT_LOOP:
    mbarrier.try_wait.relaxed.cta.shared::cta.b64 %p_control_done, [smem_control_bar], %rd_control_state;
    @!%p_control_done bra ETC_CONTROL_WAIT_LOOP;

    mbarrier.test_wait.shared::cta.b64 %p_early_done, [smem_bar], %rd_state;
    // p_early_done must be false.  Encode that expected result as one.
    selp.u32 %r_early_status, 0, 1, %p_early_done;
    st.global.u32 [%rd_out], %r_early_status;

    mov.u32 %r_tx, 1;
    mbarrier.complete_tx.relaxed.cta.shared::cta.b64 [smem_bar], %r_tx;

ETC_WAIT_LOOP:
    mbarrier.try_wait.acquire.cta.shared::cta.b64 %p_done, [smem_bar], %rd_state;
    @!%p_done bra ETC_WAIT_LOOP;

    mov.u32 %r_magic, 0xC0DEC0DE;
    st.global.u32 [%rd_out1], %r_magic;
ETC_RESULT_DONE:
    // All non-leaders exited immediately after their control arrive.
    mbarrier.inval.shared::cta.b64 [smem_bar];
    mbarrier.inval.shared::cta.b64 [smem_control_bar];
ETC_EXIT:
    ret;
}

// ---------------------------------------------------------------------------
// Test 3: mbarrier.arrive.expect_tx / complete_tx, without TMA or MMA.
//
// This is the B03-shaped protocol.  Lane 0 combines its arrival with opening
// one transaction; the other 31 lanes perform ordinary release arrivals.  A
// completed arrival count is deliberately insufficient while tx-count is one.
// The two output words are:
//   out[0] = 1          : the early wait correctly observed "not complete"
//   out[1] = 0xB03B03B0 : wait succeeded after complete_tx
// ---------------------------------------------------------------------------
.visible .entry test_mbarrier_arrive_expect_tx_complete_tx(
    .param .u64 p_out
) {
    .reg .pred %p_tid0, %p_done, %p_control_done, %p_early_done;
    .reg .u32 %r_tid, %r_count, %r_tx, %r_early_status, %r_magic;
    .reg .b64 %rd_out, %rd_out1, %rd_state, %rd_control_state;

    ld.param.u64 %rd_out, [p_out];
    add.u64 %rd_out1, %rd_out, 4;
    mov.u32 %r_tid, %tid.x;
    setp.eq.u32 %p_tid0, %r_tid, 0;

    @!%p_tid0 bra AETC_INIT_DONE;
    mov.u32 %r_count, 32;
    mbarrier.init.shared::cta.b64 [smem_bar], %r_count;
    mbarrier.init.shared::cta.b64 [smem_control_bar], %r_count;
AETC_INIT_DONE:
    // Publish both initialized barriers before the combined arrival below.
    bar.sync 0;

    mov.u32 %r_tx, 1;
    @%p_tid0 mbarrier.arrive.expect_tx.release.cta.shared::cta.b64 %rd_state, [smem_bar], %r_tx;
    @!%p_tid0 mbarrier.arrive.release.cta.shared::cta.b64 %rd_state, [smem_bar];

    // This non-acquire control barrier only proves that the 31 ordinary
    // arrivals (and the leader's combined arrival) have all executed.
    mbarrier.arrive.relaxed.cta.shared::cta.b64 %rd_control_state, [smem_control_bar];
    @!%p_tid0 bra AETC_EXIT;

AETC_CONTROL_WAIT_LOOP:
    mbarrier.try_wait.relaxed.cta.shared::cta.b64 %p_control_done, [smem_control_bar], %rd_control_state;
    @!%p_control_done bra AETC_CONTROL_WAIT_LOOP;

    // At this point arrival count is zero, but the explicit tx-count is one.
    mbarrier.test_wait.shared::cta.b64 %p_early_done, [smem_bar], %rd_state;
    selp.u32 %r_early_status, 0, 1, %p_early_done;
    st.global.u32 [%rd_out], %r_early_status;

    mbarrier.complete_tx.relaxed.cta.shared::cta.b64 [smem_bar], %r_tx;

AETC_WAIT_LOOP:
    mbarrier.try_wait.acquire.cta.shared::cta.b64 %p_done, [smem_bar], %rd_state;
    @!%p_done bra AETC_WAIT_LOOP;

    mov.u32 %r_magic, 0xB03B03B0;
    st.global.u32 [%rd_out1], %r_magic;
    mbarrier.inval.shared::cta.b64 [smem_bar];
    mbarrier.inval.shared::cta.b64 [smem_control_bar];
AETC_EXIT:
    ret;
}

// ---------------------------------------------------------------------------
// Test 4: arrive_drop changes the expected arrival count of the next phase.
//
// Phase 0 begins with an expected count of 32.  Lane 31 does arrive_drop
// while lanes 0..30 use normal arrive, so phase 0 completes normally and the
// next phase must expect only 31 arrivals.  Lane 31 then leaves the main
// mbarrier protocol.  In phase 1, exactly lanes 0..30 arrive; lane 0 can only
// observe completion if arrive_drop changed the next phase's expected count.
// ---------------------------------------------------------------------------
.visible .entry test_mbarrier_arrive_drop_next_phase(
    .param .u64 p_out
) {
    .reg .pred %p_tid0, %p_drop, %p_done;
    .reg .u32 %r_tid, %r_count, %r_magic;
    .reg .b64 %rd_out, %rd_phase0, %rd_phase1;

    ld.param.u64 %rd_out, [p_out];
    mov.u32 %r_tid, %tid.x;
    setp.eq.u32 %p_tid0, %r_tid, 0;
    setp.eq.u32 %p_drop, %r_tid, 31;

    @!%p_tid0 bra AD_INIT_DONE;
    mov.u32 %r_count, 32;
    mbarrier.init.shared::cta.b64 [smem_bar], %r_count;
AD_INIT_DONE:
    bar.sync 0;

    // Phase 0 has 32 arrivals, but one participant drops out for later
    // phases.  The bare arrive_drop spelling intentionally matches B04's
    // target action; this test has no payload-visibility assertion.
    @%p_drop mbarrier.arrive_drop.shared::cta.b64 %rd_phase0, [smem_bar];
    @!%p_drop mbarrier.arrive.release.cta.shared::cta.b64 %rd_phase0, [smem_bar];

    // This CTA barrier only keeps all 32 lanes present until lane 0 has
    // observed phase 0; it does not satisfy any arrival in the mbarrier's
    // next phase.
    bar.sync 1;
    @!%p_tid0 bra AD_PHASE0_OBSERVED;
AD_PHASE0_WAIT:
    mbarrier.try_wait.acquire.cta.shared::cta.b64 %p_done, [smem_bar], %rd_phase0;
    @!%p_done bra AD_PHASE0_WAIT;
AD_PHASE0_OBSERVED:
    bar.sync 2;

    // Lane 31 no longer participates.  Exactly 31 arrivals in phase 1 must
    // be sufficient after the phase-0 arrive_drop.
    @%p_drop bra AD_EXIT;
    mbarrier.arrive.release.cta.shared::cta.b64 %rd_phase1, [smem_bar];
    @!%p_tid0 bra AD_EXIT;
AD_PHASE1_WAIT:
    mbarrier.try_wait.acquire.cta.shared::cta.b64 %p_done, [smem_bar], %rd_phase1;
    @!%p_done bra AD_PHASE1_WAIT;

    mov.u32 %r_magic, 0xA441D04;
    st.global.u32 [%rd_out], %r_magic;
    mbarrier.inval.shared::cta.b64 [smem_bar];
AD_EXIT:
    ret;
}

// ---------------------------------------------------------------------------
// Test 5: re-use one mbarrier across four consecutive phases.
//
// mbarrier automatically re-arms after a completed phase; it must not be
// re-initialized between phases.  Every lane writes a phase-distinct payload,
// performs a release arrival, and lane 0 consumes it after an acquire wait.
// A CTA barrier occurs only *after* that consumption, so it protects the next
// write/re-use from racing the reader; it is not the visibility edge used for
// the payload.  Expected sums are 528, 3728, 6928 and 10128.
// ---------------------------------------------------------------------------
.visible .entry test_mbarrier_multi_phase_reuse(
    .param .u64 p_out
) {
    .reg .pred %p_tid0, %p_done, %p_sum_end, %p_more;
    .reg .u32 %r_tid, %r_count, %r_phase, %r_phase_base;
    .reg .u32 %r_offset, %r_value, %r_index, %r_sum;
    .reg .u32 %r_smem_base, %r_smem_addr;
    .reg .b64 %rd_out, %rd_phase_out, %rd_offset, %rd_state;

    ld.param.u64 %rd_out, [p_out];
    mov.u32 %r_tid, %tid.x;
    setp.eq.u32 %p_tid0, %r_tid, 0;

    @!%p_tid0 bra MP_INIT_DONE;
    mov.u32 %r_count, 32;
    mbarrier.init.shared::cta.b64 [smem_bar], %r_count;
MP_INIT_DONE:
    // Publish initialization before phase 0 starts.
    bar.sync 0;

    mov.u32 %r_smem_base, smem_values;
    mov.u32 %r_phase, 0;
MP_PHASE_LOOP:
    // The phase number makes stale data distinguishable from a correct reuse.
    mul.lo.u32 %r_phase_base, %r_phase, 100;
    add.u32 %r_value, %r_phase_base, %r_tid;
    add.u32 %r_value, %r_value, 1;
    shl.b32 %r_offset, %r_tid, 2;
    add.u32 %r_smem_addr, %r_smem_base, %r_offset;
    st.shared.u32 [%r_smem_addr], %r_value;

    mbarrier.arrive.release.cta.shared::cta.b64 %rd_state, [smem_bar];
    @!%p_tid0 bra MP_CONSUMED;

MP_WAIT_LOOP:
    mbarrier.try_wait.acquire.cta.shared::cta.b64 %p_done, [smem_bar], %rd_state;
    @!%p_done bra MP_WAIT_LOOP;

    // The acquire wait is the sole release->acquire edge before this load.
    mov.u32 %r_index, 0;
    mov.u32 %r_sum, 0;
MP_SUM_LOOP:
    setp.ge.u32 %p_sum_end, %r_index, 32;
    @%p_sum_end bra MP_SUM_DONE;
    shl.b32 %r_offset, %r_index, 2;
    add.u32 %r_smem_addr, %r_smem_base, %r_offset;
    ld.shared.u32 %r_value, [%r_smem_addr];
    add.u32 %r_sum, %r_sum, %r_value;
    add.u32 %r_index, %r_index, 1;
    bra MP_SUM_LOOP;
MP_SUM_DONE:
    shl.b32 %r_offset, %r_phase, 2;
    cvt.u64.u32 %rd_offset, %r_offset;
    add.u64 %rd_phase_out, %rd_out, %rd_offset;
    st.global.u32 [%rd_phase_out], %r_sum;

MP_CONSUMED:
    // This is a reuse guard only.  It follows the acquire and the shared
    // loads, so it cannot become the payload's synchronization mechanism.
    bar.sync 1;
    add.u32 %r_phase, %r_phase, 1;
    setp.lt.u32 %p_more, %r_phase, 4;
    @%p_more bra MP_PHASE_LOOP;

    // Every worker has passed its final mbarrier use before lane 0 invalidates.
    @!%p_tid0 bra MP_EXIT;
    mbarrier.inval.shared::cta.b64 [smem_bar];
MP_EXIT:
    ret;
}
